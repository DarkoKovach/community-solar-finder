{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@i18n/*": [
                "./src/i18n/*"
            ],
            "@router/*": [
                "./src/router/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@stores/*": [
                "./src/stores/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@views/*": [
                "./src/views/*"
            ],
            "@constants/*": [
                "./src/constants/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}